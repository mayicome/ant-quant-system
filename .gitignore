# ===== 大 QMT 用的 GBK 副本（不进仓库）=====
# 源码只在 qmt_builtin/src/（UTF-8）。根目录 *.py 由 tools/sync_qmt_gbk.py 在部署前生成。
/qmt_builtin/*.py
!/qmt_builtin/__init__.py
# 本机启动快照（规则全文），由 tools/export_qmt_session.py 生成
/qmt_builtin/src/ant_session_local.py
/qmt_builtin/src/ant_cancel_local.py
/qmt_builtin/src/ant_seal_local.py
/qmt_builtin/src/ant_rec_local.py

# ===== 策略生成器里的策略（用导入/导出同步，不进仓库）=====
strategy_generator_app/config/strategies/
# 批量导入选股池设置（各机本地配置）
strategy_generator_app/config/batch_import_pool_settings.json

# ===== 行情 / 缓存 / 历史数据（体积大，不备份）=====
# data/ 整目录忽略时无法再放行其中的文件，所以改成忽略内容、单独放行选股依赖。
data/*
# 股票池 / QMT 板块索引各机本地生成，不进仓库（避免另一台 pull/检查更新被挡住）。
# 新机由启动器从 COS cos/runtime/ 补齐；盘后 upload_cos_data 再上传覆盖远端。
# !data/a_share_universe.json
# !data/qmt_sector_index.json
history_data/
cache/
*.pkl
*.feather
*.parquet
*.h5
*.hdf5

# ===== 日志 / 构建产物 / 临时 =====
logs/
*.log
build_tmp/
dist_tmp/
临时*/
tmp/
temp/
*.tmp

